# SuperLink bridge daemon config. Copy to superlink_bridge.yaml and edit.
gw_mac: "010203040506"        # this bridge's 6-byte gateway MAC (hex)
# Native radio paths are configurable for installations outside a Pi home dir.
# hal_library: "/opt/sx1302_hal/libloragw/libloragw.so"
# spi_path: "/dev/spidev0.0"
# reset_script: "/opt/sx1302_hal/tools/reset_lgw.sh"
# Or keep the SX1302 on a Pi and run this daemon elsewhere over pinned SSH:
# radio:
#   host: "192.168.1.20"
#   username: "alex"
#   port: 22
#   key_file: "/data/radio_ed25519"
#   known_hosts: "/data/known_hosts"
pairing_key: null             # null => Ubiquiti factory-default pairing key
store_path: "superlink_devices.json"
adopt:                        # sensor MACs this bridge owns; or the string: all
  - "9041b22e9a53"
downlink_delay_us: 1000000    # DL TX offset after the RX hardware timestamp (1 s)
burst_spacing_us: 500000      # spacing between multiple DL frames in one response
invert_iq: false
log:
  level: "INFO"
  csv: null                   # optional path to append decoded events as CSV

# Seconds of telemetry silence before the bridge treats the link as lost and
# re-handshakes on the sensor's next discovery (two missed 300s reports). The
# timeout gates re-handshakes so they can't storm-loop.
link_lost_timeout: 700

# Operator control socket: inject app-layer commands into the RUNNING daemon
# without killing it (killing it drops the SX1302 and red-lights the sensor).
# On by default at the path below; set `control_socket: null` to disable.
# Send a command with:
#   python3 -m superlink.bridge.control send "property_set_raw 13 0 012c"
control_socket: "/tmp/superlink_bridge.sock"

# Optional management UI. Set SUPERLINK_WEB_TOKEN to a random token of at
# least 32 characters before starting. Bind to a LAN address only behind HTTPS
# or a trusted tunnel; the token grants device control and pairing access.
# web:
#   host: "127.0.0.1"
#   port: 8099
#   token_env: "SUPERLINK_WEB_TOKEN"

# Optional: MQTT / Home Assistant. DISABLED by default — uncomment this whole
# block (and set `host`) to enable. With it commented out, the daemon runs with
# no MQTT and no paho dependency.
# mqtt:
#   host: "192.168.1.10"       # MQTT broker (required to enable)
#   port: 1883
#   tls: false                 # true: verify broker cert; use TLS port (usually 8883)
#   username: null
#   password: null
#   base_topic: "superlink"    # state/command topic root
#   discovery_prefix: "homeassistant"   # HA MQTT Discovery prefix
